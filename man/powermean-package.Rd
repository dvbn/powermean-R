\name{powermean-package}
\alias{powermean-package}
\alias{powermean}
\docType{package}
\title{Powermean for R}
\description{
Development version of the native R port of Powermean 0.1.1.
Use \code{\link{fit}()} to estimate a conditional power mean with or
without fixed effects. Use \code{\link{effect}()} for the proportional
change associated with a regressor and \code{predict()} for fitted
means or counterfactuals. The getting-started vignette includes ordinary
regression, three-way gravity and the GMM1 and GMM2 estimators of
Jochmans (2017). See \doi{10.1162/REST_a_00620}.
}
\seealso{
\code{vignette("powermean", package = "powermean")} and
\code{vignette("gravity", package = "powermean")}.
}
